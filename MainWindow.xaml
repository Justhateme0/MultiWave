<Window x:Class="MultiWave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiWave"
        Height="720"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="16" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B0B0D" Offset="0" />
                    <GradientStop Color="#0E0E10" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Title bar -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="12"
                BorderBrush="#1F1F1F"
                BorderThickness="1"
                Padding="12"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="MultiWave" FontSize="18" FontWeight="Bold" Width="979" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="–" Width="36" Height="26" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource MutedBrush}" Click="MinimizeButton_OnClick" Margin="0,0,8,0" />
                    <Button Content="X" Width="36" Height="26" Background="{StaticResource AccentBrush}" Foreground="{StaticResource SurfaceBrush}" BorderBrush="#3A3A3A" Click="CloseButton_OnClick" RenderTransformOrigin="0.509,0.231" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main layout -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="12"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    Padding="18">
                <StackPanel>
                    <StackPanel x:Name="ApiInputs" Margin="0,0,0,12">
                        <TextBlock Text="API ключи"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 6" />
                        <TextBlock Text="API ID"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="ApiIdBox"
                                 Margin="0 4 0 10" />
                        <TextBlock Text="API Hash"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="ApiHashBox"
                                 Margin="0 4 0 12" />
                        <Button x:Name="SaveApiButton"
                                Content="Сохранить API"
                                Click="SaveApiButton_OnClick" />
                        <Separator Margin="0 14 0 12" Background="#2A2A2A" />
                    </StackPanel>

                    <TextBlock Text="Авторизация"
                               FontWeight="SemiBold"
                               Margin="0 0 0 8" />
                    <TextBlock Text="Телефон"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="PhoneBox"
                             Margin="0 4 0 8" />
                    <Button x:Name="SendCodeButton"
                            Content="Получить код"
                            Click="SendCodeButton_OnClick" />

                    <TextBlock Text="Код из Telegram"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0 12 0 2" />
                    <TextBox x:Name="CodeBox"
                             Margin="0 4 0 8" />

                    <TextBlock Text="Пароль 2FA (если есть)"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0 4 0 2" />
                    <PasswordBox x:Name="PasswordBox"
                                 Margin="0 4 0 12" />

                    <Button x:Name="ConfirmButton"
                            Content="Подтвердить вход"
                            Click="ConfirmButton_OnClick" />
                </StackPanel>
            </Border>

            <!-- Right panel -->
            <Grid Grid.Column="1" Margin="14 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="260" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            CornerRadius="12"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0 0 12 12">
                        <StackPanel>
                            <TextBlock Text="Аккаунты"
                                       FontWeight="SemiBold" />
                            <WrapPanel Margin="0,8,0,10">
                                <Button x:Name="SelectAllAccountsButton"
                                        Content="Выбрать все"
                                        Width="120"
                                        Margin="0,0,8,0"
                                        Click="SelectAllAccountsButton_OnClick" />
                                <Button x:Name="DeleteAccountsButton"
                                        Content="Удалить"
                                        Width="110"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="{StaticResource SurfaceBrush}"
                                        BorderBrush="#3A3A3A"
                                        Click="DeleteAccountsButton_OnClick" />
                            </WrapPanel>

                            <ListBox x:Name="AccountsList"
                                     ItemsSource="{Binding Accounts}"
                                     SelectionMode="Extended"
                                     DisplayMemberPath="DisplayLabel"
                                     MinHeight="340" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource PanelBrush}"
                            CornerRadius="12"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0 0 0 12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0 0 0 6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Диалоги"
                                           FontWeight="SemiBold"
                                           Grid.Column="0" />
                                <Button x:Name="RefreshDialogsButton"
                                        Content="Обновить"
                                        Width="110"
                                        Grid.Column="1"
                                        Click="RefreshDialogsButton_OnClick" />
                            </Grid>

                            <ListBox x:Name="DialogsList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding Dialogs}"
                                     Margin="0 0 0 8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Получатель (@user, t.me/..., id)"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="RecipientBox"
                                         Margin="0 4 0 4" />
                                <TextBlock Text="Можно вставить @ник, номер, ссылку t.me/... или invite — чат будет открыт автоматически."
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom actions -->
                <Border Grid.Row="1"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="12"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        Padding="14">
                    <TabControl Background="{StaticResource PanelBrush}" BorderThickness="0">
                        <TabItem Header="Сообщения">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Рассылка"
                                           FontWeight="SemiBold"
                                           Grid.Row="0" />

                                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0 6 0 6" HorizontalAlignment="Left">
                                    <StackPanel Width="140">
                                        <TextBlock Text="Повторов" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="RepeatCountBox" Text="1" />
                                    </StackPanel>
                                    <StackPanel Width="160" Margin="10,0,0,0">
                                        <TextBlock Text="Пауза, мс" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="DelayBox" Text="1000" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBox x:Name="MessageInput"
                                         Grid.Row="2"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="140"
                                         Margin="0 6 0 10" />

                                <Button x:Name="SendButton"
                                        Grid.Row="3"
                                        Content="Отправить"
                                        Width="180"
                                        HorizontalAlignment="Right"
                                        Click="SendButton_OnClick" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Жалобы">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0 0 0 4">
                                    <TextBlock Text="Цель жалобы (@user, t.me/..., id) или выберите диалог"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Вставьте @ник, номер, ссылку t.me/... или выберите диалог сверху."
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="ComplaintTargetBox"
                                         Grid.Row="1"
                                         Margin="0 6 0 10" />

                                <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0 0 0 8">
                                    <StackPanel Width="180">
                                        <TextBlock Text="Причина" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        <ComboBox x:Name="ComplaintReasonSelect"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="spam"
                                                  Background="#161616"
                                                  BorderBrush="#2F2F2F">
                                            <ComboBoxItem Content="Спам" Tag="spam" />
                                            <ComboBoxItem Content="Насилие/оскорбления" Tag="violence" />
                                            <ComboBoxItem Content="Порнография" Tag="porn" />
                                            <ComboBoxItem Content="Другое" Tag="other" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="10,0,0,0">
                                        <TextBlock Text="Повторов" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="ComplaintRepeatBox" Text="1" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBox x:Name="ComplaintReasonBox"
                                         Grid.Row="3"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="120"
                                         Margin="0 6 0 10" />

                                <Button x:Name="SendComplaintButton"
                                        Grid.Row="4"
                                        Content="Отправить жалобу"
                                        Width="200"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="{StaticResource SurfaceBrush}"
                                        BorderBrush="#3A3A3A"
                                        Click="SendComplaintButton_OnClick" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Grid.ColumnSpan="2"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0 10 0 0"
                   Text="Готов"
                   Foreground="{StaticResource MutedBrush}" />
    </Grid>
</Window>
