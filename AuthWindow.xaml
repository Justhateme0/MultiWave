<Window x:Class="MultiWave.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiWave Auth"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="12"
                Padding="10"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
                BorderBrush="#1F1F1F"
                BorderThickness="1">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="MultiWave" FontSize="16" FontWeight="SemiBold" Width="327" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="X" Width="34" Height="24" Background="{StaticResource AccentBrush}" Foreground="{StaticResource SurfaceBrush}" Click="CloseButton_OnClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                CornerRadius="12"
                Margin="0,10,0,0"
                BorderBrush="#2A2A2A"
                BorderThickness="1">
            <StackPanel Width="380">

                <TextBlock Text="Логин / Email" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="UsernameBox" />

                <TextBlock Text="Пароль" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                <PasswordBox x:Name="PasswordBox" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Войти" Width="120" Click="LoginButton_OnClick" Margin="0,0,10,0" />
                    <Button Content="Регистрация" Width="120" Click="RegisterButton_OnClick" />
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
